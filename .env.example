# Copy to .env and adjust. Every variable is optional; the defaults are in ARCHITECTURE.md.

# The levels root: training levels, hidden levels and budgets.toml (default: levels).
GOLEM_LEVELS_DIR=levels

# Where golem-server listens (default: 127.0.0.1). Only a loopback host is accepted.
GOLEM_HOST=127.0.0.1

# The server's port (default: 8700).
GOLEM_PORT=8700
